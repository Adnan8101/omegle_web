// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("BOT_DATABASE_WRITE_URL")
}

model Sticky {
  sticky_id        String    @id @default(uuid())
  guild_id         String
  channel_id       String
  content          String
  last_message_id  String?
  enabled          Boolean   @default(true)
  cooldown_seconds Int       @default(0)
  last_posted_at   DateTime?
  created_by       String
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([guild_id, channel_id])
  @@map("stickies")
}

model Permission {
  id           String @id @default(uuid())
  guild_id     String
  subject_type String // 'user' | 'role'
  subject_id   String
  permission   String
  effect       String // 'allow' | 'deny'

  @@index([guild_id, subject_type, subject_id])
  @@map("permissions")
}

model GuildPrefix {
  guild_id   String   @id
  prefix     String   @default(".")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("guild_prefixes")
}

model GuildCaseCounter {
  guild_id         String @id
  last_case_number Int    @default(0)

  @@map("guild_case_counter")
}

model ModerationCase {
  id               String   @id @default(uuid())
  guild_id         String
  case_number      Int
  action           String
  target_id        String
  moderator_id     String
  reason           String?
  duration_seconds Int?
  created_at       DateTime @default(now())
  active           Boolean  @default(true)

  @@index([guild_id, case_number])
  @@index([guild_id, target_id])
  @@index([guild_id, moderator_id])
  @@index([created_at])
  @@map("moderation_cases")
}

model ModeratorStats {
  id           String @id @default(uuid())
  guild_id     String
  moderator_id String
  bans         Int    @default(0)
  kicks        Int    @default(0)
  mutes        Int    @default(0)
  unmutes      Int    @default(0)
  warns        Int    @default(0)

  @@unique([guild_id, moderator_id])
  @@map("moderator_stats")
}

model UserModerationStats {
  id       String @id @default(uuid())
  guild_id String
  user_id  String
  bans     Int    @default(0)
  kicks    Int    @default(0)
  mutes    Int    @default(0)
  warns    Int    @default(0)

  @@unique([guild_id, user_id])
  @@map("user_moderation_stats")
}

model AfkUser {
  guild_id  String
  user_id   String
  reason    String?
  timestamp DateTime @default(now())

  @@id([guild_id, user_id])
  @@map("afk_users")
}

model Reminder {
  id           String   @id @default(uuid())
  guild_id     String
  user_id      String
  channel_id   String
  message      String
  remind_at    DateTime
  created_at   DateTime @default(now())
  completed    Boolean  @default(false)

  @@index([guild_id, user_id])
  @@index([remind_at, completed])
  @@map("reminders")
}

model AfkSettings {
  guild_id         String @id
  allowed_channels String // JSON string
  allowed_roles    String // JSON string
  enabled          Int    @default(1)

  @@map("afk_settings")
}

model TimeoutSettings {
  guild_id         String @id
  allowed_roles    String @default("[]") // JSON array of role IDs
  default_duration Int    @default(1036800) // Default 12 days in seconds
  success_reactions String @default("[\"✅\",\"👍\",\"🔇\",\"⏰\",\"🤫\"]") // JSON array of emojis

  @@map("timeout_settings")
}

model AutomodChannelLink {
  guild_id  String  @id
  enabled   Boolean @default(false)

  @@map("automod_channel_link")
}

model BannedWord {
  id         String   @id @default(uuid())
  guild_id   String
  word       String
  added_by   String
  created_at DateTime @default(now())

  @@map("banned_words")
}

model VoiceLog {
  id                    String    @id @default(uuid())
  guild_id              String
  user_id               String
  channel_id            String
  channel_name          String?
  joined_at             DateTime  @default(now())
  left_at               DateTime?
  duration_seconds      Int?
  
  // Activity tracking
  mute_count            Int?      @default(0)
  unmute_count          Int?      @default(0)
  deaf_count            Int?      @default(0)
  undeaf_count          Int?      @default(0)
  video_on_count        Int?      @default(0)
  video_off_count       Int?      @default(0)
  screen_share_start    Int?      @default(0)
  screen_share_stop     Int?      @default(0)
  
  // Session details
  members_present       String?   // JSON array of member IDs with join/leave times
  peak_member_count     Int?
  first_joiner_id       String?
  last_leaver_id        String?
  join_order            Int?      // User's position in join order
  leave_order           Int?      // User's position in leave order
  
  // Messages during session
  messages_sent         Int?      @default(0)
  
  // Rejoin tracking
  is_rejoin             Boolean?  @default(false)
  rejoin_count          Int?      @default(0)

  @@index([guild_id, user_id])
  @@index([guild_id, channel_id])
  @@index([joined_at])
  @@map("voice_logs")
}

model ChatLog {
  id                 String   @id @default(uuid())
  guild_id           String
  user_id            String
  channel_id         String
  channel_name       String?
  message_id         String
  content_length     Int?
  in_voice_chat      Boolean? @default(false)
  replied_to_id      String?  // Track who they're replying to
  mentioned_user_ids String?  // JSON array of mentioned user IDs (from @mentions)
  created_at         DateTime @default(now())

  @@index([guild_id, user_id])
  @@index([guild_id, channel_id])
  @@index([created_at])
  @@map("chat_logs")
}

// User interaction tracking for mutual engagement analysis
model UserInteraction {
  id                    String   @id @default(uuid())
  guild_id              String
  user_id               String   // Primary user
  target_user_id        String   // User they interacted with
  
  // VC Interaction stats
  mutual_vc_sessions    Int      @default(0)
  mutual_vc_duration    Int      @default(0)  // Total seconds in VC together
  
  // Chat interaction stats
  messages_to_target    Int      @default(0)  // Replies to target
  messages_in_same_channel Int   @default(0)  // Messages in same channels
  
  last_interaction      DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@unique([guild_id, user_id, target_user_id])
  @@index([guild_id, user_id])
  @@map("user_interactions")
}

model MailConfig {
  guild_id              String  @id
  enabled               Boolean @default(false)
  inbox_category_id     String
  transcript_channel_id String?
  ask_confirmation      Boolean? @default(false)
  closed_category_id    String?
  staff_message         String?

  @@map("mail_config")
}

model MailCategory {
  id                  String   @id @default(uuid())
  guild_id            String
  name                String
  channel_category_id String
  staff_role_ids      String[]
  auto_close_hours    Int?
  created_at          DateTime @default(now())

  @@map("mail_categories")
}

model Ticket {
  ticket_id             String    @id @default(uuid())
  guild_id              String
  user_id               String
  category_id           String
  channel_id            String?
  status                String    @default("pending") // 'pending' | 'open' | 'claimed' | 'closed'
  claimed_by            String?
  opened_at             DateTime  @default(now())
  closed_at             DateTime?
  last_user_message_at  DateTime?
  last_staff_message_at DateTime?
  reason                String?   // 'general' | 'casino' | 'promo' | 'report_mod' | 'tech_support'

  @@index([guild_id, user_id])
  @@index([guild_id, status])
  @@index([claimed_by])
  @@map("tickets")
}

model TicketMessage {
  id                String   @id @default(uuid())
  ticket_id         String
  sender_type       String   // 'user' | 'staff'
  sender_id         String
  content           String
  attachments       Json?
  embeds            Json?
  author_name       String?
  author_avatar     String?
  author_role_color String?
  created_at        DateTime @default(now())

  @@index([ticket_id])
  @@map("ticket_messages")
}

model CustomCommand {
  id         String   @id @default(uuid())
  guild_id   String
  name       String
  role_id    String
  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([guild_id, name])
  @@index([guild_id])
  @@map("custom_commands")
}

model CustomCommandPermittedUser {
  id         String   @id @default(uuid())
  guild_id   String
  target_id  String   // User or Role ID
  is_role    Boolean  @default(false)
  allowed_role_ids String[] @default([]) // Restrict which CC role(s) this entity can grant
  added_by   String
  created_at DateTime @default(now())

  @@unique([guild_id, target_id])
  @@index([guild_id])
  @@map("custom_command_permitted_users")
}

model CCPingCommand {
  id         String   @id @default(uuid())
  guild_id   String
  name       String
  role_id    String
  channel_id String
  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([guild_id, name])
  @@index([guild_id])
  @@map("ccping_commands")
}

model CCPingPermit {
  id         String   @id @default(uuid())
  guild_id   String
  target_id  String
  is_role    Boolean  @default(false)
  added_by   String
  created_at DateTime @default(now())

  @@unique([guild_id, target_id])
  @@index([guild_id])
  @@map("ccping_permits")
}

model AllowedGuild {
  id         String   @id @default(uuid())
  guild_id   String   @unique
  guild_name String?
  added_by   String
  added_at   DateTime @default(now())

  @@index([guild_id])
  @@map("allowed_guilds")
}

model ModRole {
  id         String   @id @default(uuid())
  guild_id   String
  role_id    String
  added_by   String
  created_at DateTime @default(now())

  // Moderation & Staff Command Access Matrix
  ban        Boolean @default(false)
  kick       Boolean @default(false)
  mute       Boolean @default(false)
  purge      Boolean @default(false)
  lock       Boolean @default(false)
  slowmode   Boolean @default(false)
  hide       Boolean @default(false)
  warn       Boolean @default(false)
  timeout    Boolean @default(false)
  role       Boolean @default(false)
  nick       Boolean @default(false)
  move       Boolean @default(false)
  wv         Boolean @default(false)
  suggestion Boolean @default(false)
  dm         Boolean @default(false)
  modlogs    Boolean @default(false)
  manuals    Boolean @default(false)
  av         Boolean @default(false)
  economy    Boolean @default(false)

  @@unique([guild_id, role_id])
  @@index([guild_id])
  @@map("mod_roles")
}

model BanTracking {
  id           String   @id @default(uuid())
  guild_id     String
  moderator_id String
  target_id    String
  reason       String?
  risk_level   String   @default("medium") // low, medium, high
  alert_sent   Boolean  @default(false)
  timestamp    DateTime @default(now())

  @@index([guild_id, moderator_id, timestamp])
  @@map("ban_tracking")
}

model ModeratorCooldown {
  guild_id       String
  moderator_id   String
  cooldown_until DateTime
  reason         String?
  applied_at     DateTime @default(now())

  @@id([guild_id, moderator_id])
  @@map("moderator_cooldowns")
}

model EmergencyMode {
  guild_id     String   @id
  enabled      Boolean  @default(false)
  mode_type    String?  // "raid", "scam_attack", "bot_attack"
  enabled_by   String
  enabled_at   DateTime @default(now())
  reason       String?

  @@map("emergency_modes")
}

model SafetyAdmin {
  guild_id   String
  user_id    String
  added_by   String
  added_at   DateTime @default(now())

  @@id([guild_id, user_id])
  @@map("safety_admins")
}

model PendingMailMessage {
  id         String   @id @default(uuid())
  guild_id   String
  user_id    String
  content    String
  attachments Json?
  created_at DateTime @default(now())

  @@unique([guild_id, user_id])
  @@index([guild_id, user_id])
  @@map("pending_mail_messages")
}


model WVAllowedRole {
  id         String   @id @default(uuid())
  guild_id   String
  role_id    String
  added_by   String
  created_at DateTime @default(now())

  @@unique([guild_id, role_id])
  @@index([guild_id])
  @@map("wv_allowed_roles")
}

model SuggestionConfig {
  guild_id          String  @id
  enabled           Boolean @default(false)
  channel_id        String?
  sticky_message_id String?

  @@map("suggestion_config")
}

model Suggestion {
  id                String    @id @default(uuid())
  guild_id          String
  channel_id        String
  message_id        String    @unique
  author_id         String
  suggestion        String
  suggestion_number Int
  status            String    @default("pending") // pending, approved, denied, considered
  admin_response    String?
  reviewed_by       String?
  reviewed_at       DateTime?
  created_at        DateTime  @default(now())

  @@index([guild_id])
  @@index([status])
  @@index([guild_id, suggestion_number])
  @@map("suggestions")
}

model ModActionRateLimit {
  id           String   @id @default(uuid())
  guild_id     String
  moderator_id String
  action       String   // 'ban', 'kick'
  timestamp    DateTime @default(now())

  @@index([guild_id, moderator_id, timestamp])
  @@map("mod_action_rate_limits")
}

model ModCooldownOverride {
  id           String   @id @default(uuid())
  guild_id     String
  moderator_id String
  granted_by   String
  granted_at   DateTime @default(now())
  expires_at   DateTime

  @@unique([guild_id, moderator_id])
  @@index([expires_at])
  @@map("mod_cooldown_overrides")
}

model ModActionBlock {
  id           String   @id @default(uuid())
  guild_id     String
  moderator_id String
  blocked_at   DateTime @default(now())
  reason       String

  @@unique([guild_id, moderator_id])
  @@map("mod_action_blocks")
}

model ModConfig {
  guild_id       String  @id
  log_channel_id String?
  
  @@map("mod_config")
}

// =====================================
// MANUAL SYSTEM MODELS
// =====================================

model Manual {
  id            String   @id @default(uuid())
  manual_number Int
  guild_id      String
  target_id     String
  moderator_id  String
  offense       String
  action        String
  advise        String?
  note_proof    String?
  log_message_id String?
  reviewed_by   String[] @default([])
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([guild_id, target_id])
  @@index([guild_id, manual_number])
  @@index([guild_id, moderator_id])
  @@map("manuals")
}

model ManualCounter {
  guild_id          String @id
  last_manual_number Int   @default(0)

  @@map("manual_counters")
}

model ManualConfig {
  guild_id       String @id
  log_channel_id String?

  @@map("manual_config")
}

model VoiceChannelRole {
  id         String @id @default(uuid())
  guild_id   String
  channel_id String
  role_id    String
  created_at DateTime @default(now())

  @@unique([guild_id, channel_id])
  @@index([guild_id])
  @@map("voice_channel_roles")
}

// =====================================
// VOICE TRACKING SYSTEM
// =====================================

model VoiceTracking {
  id                   String   @id @default(uuid())
  guild_id             String
  user_id              String
  channel_id           String
  joined_at            DateTime @default(now())
  left_at              DateTime?
  
  // Time tracking in seconds
  time_speaking        Int      @default(0) // Time with mic on
  time_muted           Int      @default(0) // Time with mic muted
  time_deafened        Int      @default(0) // Time deafened
  time_listening       Int      @default(0) // Time not muted/deafened (active listening)
  
  // State tracking
  was_muted            Boolean  @default(false)
  was_deafened         Boolean  @default(false)
  last_state_change    DateTime @default(now())

  @@index([guild_id, user_id])
  @@index([guild_id, channel_id])
  @@map("voice_tracking")
}

model VoiceUserStats {
  id                      String   @id @default(uuid())
  guild_id                String
  user_id                 String
  
  // Cumulative time in seconds
  total_time_in_vc        Int      @default(0)
  total_time_speaking     Int      @default(0)
  total_time_muted        Int      @default(0)
  total_time_deafened     Int      @default(0)
  total_time_listening    Int      @default(0)
  
  // Session counts
  total_sessions          Int      @default(0)
  
  // Stats
  last_joined_at          DateTime?
  updated_at              DateTime @updatedAt

  @@unique([guild_id, user_id])
  @@index([guild_id])
  @@map("voice_user_stats")
}

// =====================================
// END MANUAL SYSTEM MODELS
// =====================================
// =====================================
// UNBAN APPEAL SYSTEM MODELS
// =====================================

model AppealConfig {
  id                    String   @id @default(uuid())
  guild_id              String   // Main server ID where the config was set
  main_server_id        String   // Main server where bans are checked
  appeal_server_id      String   // Appeal server where tickets are created
  ticket_channel_id     String   // Channel where the ticket panel is sent
  opening_category_id   String   // Category for new tickets
  closed_category_id    String?  // Category for closed tickets
  transcript_channel_id String   // Channel for transcripts
  staff_role_ids        String[] // Staff roles that can manage tickets
  opening_message       String?  // Custom opening message
  
  // Embed customization
  embed_title           String   @default("Unban Appeal")
  embed_description     String   @default("Click the button below to submit an unban appeal.")
  button_text           String   @default("Open Appeal")
  
  // Panel message tracking
  panel_message_id      String?  // Message ID of the ticket panel
  
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@unique([main_server_id, appeal_server_id])
  @@index([guild_id])
  @@index([appeal_server_id])
  @@map("appeal_configs")
}

model AppealTicket {
  ticket_id         String    @id @default(uuid())
  config_id         String    // Reference to AppealConfig
  main_server_id    String    // Main server the user is banned from
  appeal_server_id  String    // Appeal server where ticket is created
  user_id           String    // User who created the appeal
  channel_id        String?   // Ticket channel ID
  display_id        Int       // Display number (e.g., 1234)
  
  status            String    @default("open") // 'open' | 'claimed' | 'closed'
  claimed_by        String?   // Staff member who claimed
  
  opened_at         DateTime  @default(now())
  closed_at         DateTime?

  @@index([appeal_server_id, user_id])
  @@index([appeal_server_id, status])
  @@index([channel_id])
  @@map("appeal_tickets")
}

model AppealTicketMessage {
  id                String   @id @default(uuid())
  ticket_id         String
  sender_type       String   // 'user' | 'staff'
  sender_id         String
  content           String
  attachments       Json?
  embeds            Json?
  author_name       String?
  author_avatar     String?
  author_role_color String?
  created_at        DateTime @default(now())

  @@index([ticket_id])
  @@map("appeal_ticket_messages")
}

// =====================================
// END UNBAN APPEAL SYSTEM MODELS
// =====================================

// =====================================
// MESSAGE TRACKING SYSTEM MODELS
// =====================================

model MessageTrackingConfig {
  guild_id String  @id
  enabled  Boolean @default(false)

  @@map("message_tracking_config")
}

model MessageTrackingBlacklistChannel {
  guild_id   String
  channel_id String

  @@id([guild_id, channel_id])
  @@map("message_tracking_blacklist_channels")
}

model MessageTrackingBlacklistRole {
  guild_id String
  role_id  String

  @@id([guild_id, role_id])
  @@map("message_tracking_blacklist_roles")
}

model UserMessageStats {
  id              String    @id @default(uuid())
  guild_id        String
  user_id         String
  message_count   Int       @default(0)
  last_message_at DateTime?

  @@unique([guild_id, user_id])
  @@index([guild_id, message_count])
  @@map("user_message_stats")
}

// =====================================
// END MESSAGE TRACKING SYSTEM MODELS
// =====================================

// =====================================
// ECONOMY / POINTS SYSTEM MODELS
// =====================================

model EconomyConfig {
  guild_id              String   @id
  
  // Message settings (global/simple mode)
  messages_per_point    Int      @default(25)    // Messages per cycle
  msg_ozy_amount        Int      @default(1)     // Coins per cycle
  min_message_length    Int      @default(5)
  message_cooldown      Int      @default(5)     // seconds between messages
  
  // Voice settings (global/simple mode)
  minutes_per_point     Int      @default(5)     // Minutes per cycle
  vc_ozy_amount         Int      @default(1)     // Coins per cycle
  require_two_members   Int      @default(1)     // Min members in VC
  count_bots            Boolean  @default(false) // Include bots in member count
  ignore_afk_channel    Boolean  @default(true)
  ignore_self_muted     Boolean  @default(false)
  ignore_deafened       Boolean  @default(false)
  afk_channel_id        String?
  
  // Currency
  currency_name         String   @default("Ozy")
  currency_emoji        String   @default("🪙")
  
  // Leaderboard settings
  leaderboard_sync      Boolean  @default(true)
  
  // Logs
  logs_channel_id       String?
  economy_channel_id    String?
  
  enabled               Boolean  @default(false)
  advanced_mode         Boolean  @default(false)
  shop_enabled          Boolean  @default(true)
  
  // Invite system
  invites_enabled       Boolean  @default(true)
  coins_per_invite      Int      @default(100)  // Coins earned when someone joins via invite
  
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@map("economy_config")
}

model EconomyBlacklistChannel {
  guild_id     String
  channel_id   String
  channel_type String   // 'text' or 'voice'
  added_by     String
  created_at   DateTime @default(now())

  @@id([guild_id, channel_id])
  @@index([guild_id, channel_type])
  @@map("economy_blacklist_channels")
}

model EconomyBlacklistRole {
  guild_id   String
  role_id    String
  added_by   String
  created_at DateTime @default(now())

  @@id([guild_id, role_id])
  @@index([guild_id])
  @@map("economy_blacklist_roles")
}

model EconomyBlacklistCategory {
  guild_id    String
  category_id String
  added_by    String
  created_at  DateTime @default(now())

  @@id([guild_id, category_id])
  @@index([guild_id])
  @@map("economy_blacklist_categories")
}

model EconomyBlacklistMember {
  guild_id   String
  user_id    String
  user_name  String?
  added_by   String
  created_at DateTime @default(now())

  @@id([guild_id, user_id])
  @@index([guild_id])
  @@map("economy_blacklist_members")
}

// Category-based rewards for advanced mode
model EconomyCategoryReward {
  id                 String   @id @default(uuid())
  guild_id           String
  category_id        String
  category_name      String?
  
  // Voice rewards
  vc_enabled         Boolean  @default(true)
  vc_minutes_per_point Int    @default(5)       // Minutes per cycle
  vc_ozy_amount      Int      @default(1)       // Coins per cycle
  vc_min_members     Int      @default(1)       // Min members in VC
  vc_count_bots      Boolean  @default(false)   // Include bots in member count
  vc_ignore_self_muted Boolean @default(false)  // Ignore users who are self-muted
  vc_ignore_deafened Boolean  @default(false)   // Ignore users who are deafened
  
  // Message rewards
  message_enabled    Boolean  @default(true)
  messages_per_point Int      @default(25)      // Messages per cycle
  msg_ozy_amount     Int      @default(1)       // Coins per cycle
