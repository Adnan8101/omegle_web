// This is a copy of the bot's schema for generating Prisma client in the web app
// Original: my_pvt/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("BOT_DATABASE_URL")
}

// ===== ECONOMY MODELS =====

model EconomyConfig {
  guild_id              String   @id
  
  // Message settings (global/simple mode)
  messages_per_point    Int      @default(25)    // X messages = threshold
  msg_ozy_amount        Int      @default(1)     // Ozy to award when threshold met
  min_message_length    Int      @default(5)
  message_cooldown      Int      @default(5)     // seconds between counted messages
  daily_message_cap     Int      @default(100)   // max Ozy from messages per day
  
  // Voice settings (global/simple mode)
  minutes_per_point     Int      @default(5)     // X minutes = threshold
  vc_ozy_amount         Int      @default(1)     // Ozy to award when threshold met
  daily_voice_cap       Int      @default(100)   // max Ozy from VC per day
  require_two_members   Int      @default(2)     // Minimum members required in VC
  ignore_afk_channel    Boolean  @default(true)
  ignore_self_muted     Boolean  @default(false)
  afk_channel_id        String?
  
  // Currency
  currency_name         String   @default("Ozy")
  currency_emoji        String   @default("🪙")
  
  // Leaderboard settings
  leaderboard_sync      Boolean  @default(true)   // If true, spending reduces leaderboard. If false, only earnings count
  
  // Logs
  logs_channel_id       String?

  // Channel restrictions
  economy_channel_id    String?
  
  enabled               Boolean  @default(false)
  
  // Advanced mode - per-category rewards
  advanced_mode         Boolean  @default(false)
  
  // Shop settings
  shop_enabled          Boolean  @default(true)
  
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@map("economy_config")
}

model EconomyUser {
  id                    String   @id @default(uuid())
  guild_id              String
  user_id               String
  
  // Message tracking
  total_messages        Int      @default(0)
  valid_messages        Int      @default(0)
  redeemable_messages   Int      @default(0)
  claimed_messages      Int      @default(0)
  messages_today        Int      @default(0)
  last_message_at       DateTime?
  last_message_date     String?
  
  // Voice tracking
  total_vc_minutes      Int      @default(0)
  redeemable_vc_minutes Int      @default(0)
  claimed_vc_minutes    Int      @default(0)
  vc_minutes_today      Int      @default(0)
  last_vc_date          String?
  
  // Points
  total_points          Int      @default(0)
  weekly_points         Int      @default(0)
  monthly_points        Int      @default(0)
  
  // Leaderboard
  leaderboard_points    Int      @default(0)
  
  // Tracking
  week_start            String?
  month_start           String?
  
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@unique([guild_id, user_id])
  @@index([guild_id, total_points])
  @@index([guild_id, weekly_points])
  @@index([guild_id, monthly_points])
  @@index([guild_id, leaderboard_points])
  @@map("economy_users")
}

model EconomyPointLog {
  id          String   @id @default(uuid())
  guild_id    String
  user_id     String
  amount      Int
  reason      String
  source      String
  admin_id    String?
  created_at  DateTime @default(now())

  @@index([guild_id, user_id])
  @@index([guild_id, created_at])
  @@map("economy_point_logs")
}

model ShopItem {
  id               String    @id @default(uuid())
  guild_id         String
  name             String
  price            Int       @default(0)
  description      String?
  thumbnail        String?
  stock            Int?
  income_amount    Int?
  time_hours       Int?
  role_required_id String?
  role_given_id    String?
  role_removed_id  String?
  required_balance Int?
  reply_message    String?
  expires_in_days  Int?
  expires_at       DateTime?
  enabled          Boolean   @default(true)
  created_by       String
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@unique([guild_id, name])
  @@index([guild_id])
  @@map("shop_items")
}

// Category-based rewards for advanced mode
model EconomyCategoryReward {
  id                 String   @id @default(uuid())
  guild_id           String
  category_id        String
  category_name      String?
  
  // Voice rewards for this category
  vc_enabled         Boolean  @default(true)
  vc_minutes_per_point Int    @default(1)      // X minutes = 1 coin (renamed from amount)
  vc_ozy_amount      Int      @default(1)      // How many Ozy to give when threshold met
  vc_daily_limit     Int      @default(100)    // Daily cap per user
  vc_min_members     Int      @default(2)      // Minimum members in VC
  
  // Message rewards for this category  
  message_enabled    Boolean  @default(true)
  messages_per_point Int      @default(25)     // X messages = 1 coin (threshold)
  msg_ozy_amount     Int      @default(1)      // How many Ozy to give when threshold met
  msg_daily_limit    Int      @default(100)    // Daily cap per user
  msg_min_length     Int      @default(5)      // Min message length
  msg_cooldown       Int      @default(5)      // Cooldown between messages in seconds
  
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([guild_id, category_id])
  @@index([guild_id])
  @@map("economy_category_rewards")
}

// Shop item toggles
model ShopItemToggle {
  guild_id   String
  item_id    String
  enabled    Boolean  @default(true)
  updated_by String
  updated_at DateTime @updatedAt

  @@id([guild_id, item_id])
  @@map("shop_item_toggles")
}

// Blacklist channels
model EconomyBlacklistChannel {
  guild_id     String
  channel_id   String
  channel_type String
  added_by     String
  created_at   DateTime @default(now())

  @@id([guild_id, channel_id])
  @@index([guild_id, channel_type])
  @@map("economy_blacklist_channels")
}

// Blacklist roles
model EconomyBlacklistRole {
  guild_id   String
  role_id    String
  added_by   String
  created_at DateTime @default(now())

  @@id([guild_id, role_id])
  @@index([guild_id])
  @@map("economy_blacklist_roles")
}

// Blacklist categories
model EconomyBlacklistCategory {
  guild_id    String
  category_id String
  added_by    String
  created_at  DateTime @default(now())

  @@id([guild_id, category_id])
  @@index([guild_id])
  @@map("economy_blacklist_categories")
}

model ShopPurchase {
  id           String    @id @default(uuid())
  guild_id     String
  user_id      String
  item_id      String
  item_name    String
  price_paid   Int
  redeem_code  String    @unique
  status       String    @default("pending")
  redeemed_at  DateTime?
  redeemed_by  String?
  proof_link   String?
  created_at   DateTime  @default(now())

  @@index([guild_id, user_id])
  @@index([redeem_code])
  @@map("shop_purchases")
}

model CasinoAdminRole {
  guild_id   String
  role_id    String

  @@id([guild_id, role_id])
  @@index([guild_id])
  @@map("casino_admin_roles")
}

// ===== MODERATION MODELS =====

model ModCase {
  id          String    @id @default(cuid())
  guild_id    String
  case_num    Int
  action      String
  target_id   String
  mod_id      String
  reason      String?
  duration    String?
  expires_at  DateTime?
  created_at  DateTime  @default(now())

  @@unique([guild_id, case_num])
  @@index([guild_id, target_id])
}

model GuildMuteRole {
  guild_id   String @id
  role_id    String
  created_at DateTime @default(now())
}

model ActiveMute {
  id         String   @id @default(cuid())
  guild_id   String
  user_id    String
  role_id    String
  expires_at DateTime
  created_at DateTime @default(now())

  @@unique([guild_id, user_id])
  @@index([expires_at])
}

model ActiveBan {
  id         String   @id @default(cuid())
  guild_id   String
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())

  @@unique([guild_id, user_id])
  @@index([expires_at])
}

// ===== AFK SYSTEM =====

model AfkStatus {
  id         String   @id @default(cuid())
  guild_id   String
  user_id    String
  reason     String   @default("AFK")
  start_time DateTime @default(now())

  @@unique([guild_id, user_id])
}

// ===== GIVEAWAY SYSTEM =====

model Giveaway {
  id              String    @id @default(cuid())
  guild_id        String
  channel_id      String
  message_id      String    @unique
  host_id         String
  prize           String
  winner_count    Int       @default(1)
  ends_at         DateTime
  ended           Boolean   @default(false)
  winners         String[]
  required_roles  String[]
  blacklist_roles String[]
  created_at      DateTime  @default(now())
  participants    GiveawayParticipant[]

  @@index([guild_id])
  @@index([ends_at])
}

model GiveawayParticipant {
  id          String   @id @default(cuid())
  giveaway_id String
  user_id     String
  entries     Int      @default(1)
  joined_at   DateTime @default(now())

  giveaway Giveaway @relation(fields: [giveaway_id], references: [id], onDelete: Cascade)

  @@unique([giveaway_id, user_id])
}

// ===== STICKY MESSAGES =====

model StickyMessage {
  id            String   @id @default(cuid())
  guild_id      String
  channel_id    String   @unique
  content       String
  embed_json    String?
  last_msg_id   String?
  created_by    String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([guild_id])
}

// ===== MAIL SYSTEM =====

model MailThread {
  id           String    @id @default(cuid())
  guild_id     String
  user_id      String
  channel_id   String    @unique
  status       String    @default("open")
  topic        String?
  created_at   DateTime  @default(now())
  closed_at    DateTime?
  closed_by    String?

  @@index([guild_id, user_id])
  @@index([guild_id, status])
}

model MailConfig {
  guild_id      String  @id
  category_id   String?
  log_channel   String?
  ping_roles    String[]
  welcome_msg   String?
  close_msg     String?
  staff_roles   String[]
}

// ===== AUTO MODERATION =====

model AutomodConfig {
  guild_id         String   @id
  enabled          Boolean  @default(false)
  spam_enabled     Boolean  @default(false)
  spam_threshold   Int      @default(5)
  spam_interval    Int      @default(5000)
  link_enabled     Boolean  @default(false)
  link_whitelist   String[]
  word_enabled     Boolean  @default(false)
  word_list        String[]
  caps_enabled     Boolean  @default(false)
  caps_percentage  Int      @default(70)
  caps_min_length  Int      @default(10)
  emoji_enabled    Boolean  @default(false)
  emoji_limit      Int      @default(10)
  mention_enabled  Boolean  @default(false)
  mention_limit    Int      @default(5)
  invite_enabled   Boolean  @default(false)
  exempt_roles     String[]
  exempt_channels  String[]
  log_channel      String?
  actions          Json?
}

// ===== GREETING SYSTEM =====

model GreetConfig {
  guild_id        String  @id
  welcome_channel String?
  welcome_message String?
  welcome_embed   Json?
  leave_channel   String?
  leave_message   String?
  leave_embed     Json?
  dm_enabled      Boolean @default(false)
  dm_message      String?
}

// ===== APPEAL SYSTEM =====

model AppealConfig {
  guild_id          String   @id
  enabled           Boolean  @default(false)
  review_channel_id String?
  cooldown_days     Int      @default(7)
  appeal_types      String[]  @default(["ban", "mute", "warn"])
}

model Appeal {
  id           String   @id @default(cuid())
  guild_id     String
  user_id      String
  appeal_type  String
  case_id      String?
  reason       String
  status       String   @default("pending")
  reviewed_by  String?
  review_note  String?
  message_id   String?
  created_at   DateTime @default(now())
  reviewed_at  DateTime?

  @@index([guild_id, user_id])
  @@index([guild_id, status])
}

// ===== LOGGING =====

model LogConfig {
  guild_id        String  @id
  mod_log         String?
  message_log     String?
  member_log      String?
  voice_log       String?
  server_log      String?
  ignored_channels String[]
}

// ===== MEDIA CHANNELS =====

model MediaChannel {
  id         String   @id @default(cuid())
  guild_id   String
  channel_id String   @unique
  created_by String
  created_at DateTime @default(now())

  @@index([guild_id])
}

// ===== VOICE CHANNEL ROLES =====

model VoiceChannelRole {
  id         String   @id @default(cuid())
  guild_id   String
  channel_id String
  role_id    String
  created_by String
  created_at DateTime @default(now())

  @@unique([channel_id, role_id])
  @@index([guild_id])
}

// ===== REMINDERS =====

model Reminder {
  id          String   @id @default(cuid())
  guild_id    String?
  channel_id  String
  user_id     String
  message     String
  remind_at   DateTime
  created_at  DateTime @default(now())
  dm          Boolean  @default(false)

  @@index([remind_at])
  @@index([user_id])
}

// ===== PREFIX SETTINGS =====

model GuildPrefix {
  guild_id String @id
  prefix   String @default("!")
}

// ===== VOICE TRACKING SYSTEM =====

model VoiceTracking {
  id                   String   @id @default(uuid())
  guild_id             String
  user_id              String
  channel_id           String
  joined_at            DateTime @default(now())
  left_at              DateTime?
  
  // Time tracking in seconds
  time_speaking        Int      @default(0) // Time with mic on
  time_muted           Int      @default(0) // Time with mic muted
  time_deafened        Int      @default(0) // Time deafened
  time_listening       Int      @default(0) // Time not muted/deafened (active listening)
  
  // State tracking
  was_muted            Boolean  @default(false)
  was_deafened         Boolean  @default(false)
  last_state_change    DateTime @default(now())

  @@index([guild_id, user_id])
  @@index([guild_id, channel_id])
  @@map("voice_tracking")
}

model VoiceUserStats {
  id                      String   @id @default(uuid())
  guild_id                String
  user_id                 String
  
  // Cumulative time in seconds
  total_time_in_vc        Int      @default(0)
  total_time_speaking     Int      @default(0)
  total_time_muted        Int      @default(0)
  total_time_deafened     Int      @default(0)
  total_time_listening    Int      @default(0)
  
  // Session counts
  total_sessions          Int      @default(0)
  
  // Stats
  last_joined_at          DateTime?
  updated_at              DateTime @updatedAt

  @@unique([guild_id, user_id])
  @@index([guild_id])
  @@map("voice_user_stats")
}

// ===== ECONOMY PROGRESS TRACKING =====

// Track partial progress for VC time per category (accumulation system)
model EconomyVCProgress {
  id                String   @id @default(uuid())
  guild_id          String
  user_id           String
  category_id       String   // Category being tracked (or "global" for non-advanced mode)
  
  accumulated_seconds Int    @default(0)    // Total seconds accumulated towards next reward
  today_earned      Int      @default(0)    // Ozy earned today in this category
  last_date         String?                 // YYYY-MM-DD for daily reset
  
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  
  @@unique([guild_id, user_id, category_id])
  @@index([guild_id, user_id])
  @@map("economy_vc_progress")
}

// Track partial progress for messages per category (accumulation system)
model EconomyMessageProgress {
  id                String   @id @default(uuid())
  guild_id          String
  user_id           String
  category_id       String   // Category being tracked (or "global" for non-advanced mode)
  
  accumulated_msgs  Int      @default(0)    // Messages accumulated towards next reward
  today_earned      Int      @default(0)    // Ozy earned today in this category  
  last_message_at   DateTime?               // For cooldown tracking
  last_date         String?                 // YYYY-MM-DD for daily reset
  
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  
  @@unique([guild_id, user_id, category_id])
  @@index([guild_id, user_id])
  @@map("economy_message_progress")
}

// ===== DISCORD USER CACHE =====

model DiscordUserCache {
  user_id        String   @id
  username       String
  display_name   String
  avatar_url     String?
  global_name    String?
  discriminator  String   @default("0")
  in_guild       Boolean  @default(true)
  roles          String?  // JSON array of role IDs
  nickname       String?
  joined_at      String?
  updated_at     DateTime @updatedAt
  created_at     DateTime @default(now())

  @@index([username])
  @@index([display_name])
  @@map("discord_user_cache")
}

// ===== DISCORD CHANNEL CACHE =====

model DiscordChannelCache {
  channel_id     String   @id
  guild_id       String
  name           String
  type           Int      @default(2)  // 0=text, 2=voice, 13=stage, etc.
  parent_id      String?              // Category channel ID
  parent_name    String?              // Category channel name
  position       Int      @default(0)
  is_deleted     Boolean  @default(false)
  updated_at     DateTime @updatedAt
  created_at     DateTime @default(now())

  @@index([guild_id])
  @@index([name])
  @@map("discord_channel_cache")
}

// ===== VOICE LOGS =====

model VoiceLog {
  id                    String    @id @default(uuid())
  guild_id              String
  user_id               String
  channel_id            String
  channel_name          String?
  joined_at             DateTime  @default(now())
  left_at               DateTime?
  duration_seconds      Int?
  
  // Activity tracking
  mute_count            Int?      @default(0)
  unmute_count          Int?      @default(0)
  deaf_count            Int?      @default(0)
  undeaf_count          Int?      @default(0)
  video_on_count        Int?      @default(0)
  video_off_count       Int?      @default(0)
  screen_share_start    Int?      @default(0)
  screen_share_stop     Int?      @default(0)
  
  // Session details
  members_present       String?   // JSON array of member IDs with join/leave times
  peak_member_count     Int?
  first_joiner_id       String?
  last_leaver_id        String?
  join_order            Int?      // User's position in join order
  leave_order           Int?      // User's position in leave order
  
  // Messages during session
  messages_sent         Int?      @default(0)
  
  // Rejoin tracking
  is_rejoin             Boolean?  @default(false)
  rejoin_count          Int?      @default(0)

  @@index([guild_id, user_id])
  @@index([guild_id, channel_id])
  @@index([joined_at])
  @@map("voice_logs")
}
