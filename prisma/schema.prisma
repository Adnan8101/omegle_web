// =====================================
// DONATOR / SUBSCRIPTION SYSTEM
// =====================================

model DonatorPlan {
  id               String                @id @default(uuid())
  guild_id         String
  title            String // e.g., "Premium", "Gold", "Platinum"
  description      String?
  price            Int // Price in USD (will be converted to INR)
  perks            String[] // Array of perks/benefits
  linked_role_id   String // Role ID to assign when user purchases
  enabled          Boolean               @default(true)
  paused           Boolean               @default(false)
  crypto_enabled   Boolean               @default(true)
  price_crypto     Int? // Optional Crypto price override in USD (will default to price if null)
  ozy_enabled      Boolean               @default(false)
  price_ozy        Int? // Ozy amount charged for direct balance purchases
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt
  created_by       String // Admin user ID
  subscriptions    DonatorSubscription[]
  payments         RazorpayPayment[]
  nowpayments_payments NowPaymentsPayment[]

  @@unique([guild_id, title])
  @@index([guild_id])
  @@index([linked_role_id])
  @@map("donator_plans")
}

model DonatorSubscription {
  id           String      @id @default(uuid())
  guild_id     String
  user_id      String
  plan_id      String
  plan         DonatorPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  status       String      @default("active") // active, cancelled, expired
  start_date   DateTime    @default(now())
  expiry_date  DateTime? // null for lifetime
  cancelled_at DateTime?
  cancelled_by String? // Admin ID if manually cancelled
  payment_id   String? // Razorpay payment ID
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  @@unique([guild_id, user_id, plan_id])
  @@index([guild_id, user_id])
  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@map("donator_subscriptions")
}

model RazorpayPayment {
  id                String      @id @default(uuid()) // Our UUID
  razorpay_id       String?     @unique // Razorpay payment ID
  razorpay_order_id String      @unique
  guild_id          String
  user_id           String
  plan_id           String
  plan              DonatorPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  amount            Int // Amount in INR smallest unit (paise)
  currency          String      @default("INR")
  amount_usd        Int // Original amount in USD
  status            String      @default("created") // created, authorized, captured, error, failed
  method            String? // Payment method
  webhook_data      Json? // Raw webhook response from Razorpay
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  @@index([razorpay_id])
  @@index([razorpay_order_id])
  @@index([user_id])
  @@index([guild_id])
  @@index([status])
  @@map("razorpay_payments")
}

model NowPaymentsPayment {
  id                String      @id @default(uuid())
  payment_id        String?     @unique // NowPayments payment ID (null at creation)
  invoice_id        String?     @unique // NowPayments invoice ID (null if not invoice)
  order_id          String      @unique // Our internal UUID order ID
  guild_id          String
  user_id           String
  plan_id           String
  plan              DonatorPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  price_amount      Int         // Amount in USD cents
  price_currency    String      @default("usd")
  pay_amount        Float?      // Crypto amount paid (from webhook)
  pay_currency      String?     // Crypto string e.g. "ltc", "usdttrc20"
  status            String      @default("waiting") // waiting, confirming, confirmed, sending, partially_paid, finished, failed, refunded, expired
  payment_url       String?     // Invoice checkout URL
  webhook_data      Json?       // Raw webhook payload
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  @@index([payment_id])
  @@index([order_id])
  @@index([user_id])
  @@index([guild_id])
  @@index([status])
  @@map("nowpayments_payments")
}

