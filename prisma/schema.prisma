enum AppealTicketStatus {
  claimed
  closed
  open
}

enum ModerationAction {
  ban
  kick
  manual
  mute
  unban
  unmute
  warn
}

enum PermissionEffect {
  allow
  deny
}

enum TicketStatus {
  claimed
  closed
  open
  pending
}

model AdminRole {
  added_by   String
  guild_id   String   @id
  role_id    String
  updated_at DateTime @updatedAt

  @@map("admin_roles")
}

model AfkSettings {
  allowed_channels    String // JSON string
  allowed_channels_v2 Json?
  allowed_roles       String // JSON string
  allowed_roles_v2    Json?
  enabled             Int    @default(1)
  guild_id            String @id

  @@map("afk_settings")
}

model AfkUser {
  guild_id  String
  reason    String?
  timestamp DateTime @default(now())
  user_id   String

  @@id([guild_id, user_id])
  @@map("afk_users")
}

model AgVouch {
  created_at         DateTime @default(now())
  guild_id           String
  id                 String   @id @default(uuid())
  note               String?
  target_user_id     String
  updated_at         DateTime @updatedAt
  vouched_by_user_id String

  @@unique([guild_id, target_user_id, vouched_by_user_id])
  @@index([guild_id, vouched_by_user_id])
  @@map("ag_vouches")
}

model AllowedGuild {
  added_at   DateTime @default(now())
  added_by   String
  guild_id   String   @unique
  guild_name String?
  id         String   @id @default(uuid())

  @@index([guild_id])
  @@map("allowed_guilds")
}

model AppealConfig {
  appeal_server_id      String // Appeal server where tickets are created
  button_text           String   @default("Open Appeal")
  closed_category_id    String? // Category for closed tickets
  created_at            DateTime @default(now())
  embed_description     String   @default("Click the button below to submit an unban appeal.")
  embed_title           String   @default("Unban Appeal")
  guild_id              String // Main server ID where the config was set
  id                    String   @id @default(uuid())
  main_server_id        String // Main server where bans are checked
  opening_category_id   String // Category for new tickets
  opening_message       String? // Custom opening message
  panel_message_id      String? // Message ID of the ticket panel
  staff_role_ids        String[] // Staff roles that can manage tickets
  ticket_channel_id     String // Channel where the ticket panel is sent
  transcript_channel_id String // Channel for transcripts
  updated_at            DateTime @updatedAt

  @@unique([main_server_id, appeal_server_id])
  @@index([appeal_server_id])
  @@index([guild_id])
  @@map("appeal_configs")
}

model AppealTicket {
  appeal_server_id String // Appeal server where ticket is created
  channel_id       String? // Ticket channel ID
  claimed_by       String? // Staff member who claimed
  closed_at        DateTime?
  config_id        String // Reference to AppealConfig
  display_id       Int // Display number (e.g., 1234)
  main_server_id   String // Main server the user is banned from
  opened_at        DateTime            @default(now())
  status           String              @default("open") // 'open' | 'claimed' | 'closed'
  status_v2        AppealTicketStatus?
  ticket_id        String              @id @default(uuid())
  user_id          String // User who created the appeal

  @@index([appeal_server_id, status])
  @@index([appeal_server_id, user_id])
  @@index([channel_id])
  @@map("appeal_tickets")
}

model AppealTicketMessage {
  attachments       Json?
  author_avatar     String?
  author_name       String?
  author_role_color String?
  content           String
  created_at        DateTime @default(now())
  embeds            Json?
  id                String   @id @default(uuid())
  sender_id         String
  sender_type       String // 'user' | 'staff'
  ticket_id         String

  @@index([ticket_id])
  @@map("appeal_ticket_messages")
}

model AutoRole {
  added_by   String
  created_at DateTime @default(now())
  guild_id   String
  id         String   @id @default(uuid())
  role_id    String

  @@unique([guild_id, role_id])
  @@map("auto_roles")
}

model AutomodChannelLink {
  enabled  Boolean @default(false)
  guild_id String  @id

  @@map("automod_channel_link")
}

model BanTracking {
  alert_sent   Boolean  @default(false)
  guild_id     String
  id           String   @id @default(uuid())
  moderator_id String
  reason       String?
  risk_level   String   @default("medium") // low, medium, high
  target_id    String
  timestamp    DateTime @default(now())

  @@index([guild_id, moderator_id, timestamp])
  @@map("ban_tracking")
}

model BannedWord {
  added_by   String
  created_at DateTime @default(now())
  guild_id   String
  id         String   @id @default(uuid())
  word       String

  @@map("banned_words")
}

model BotCmdAllowedChannel {
  added_by   String
  channel_id String
  created_at DateTime @default(now())
  guild_id   String

  @@id([guild_id, channel_id])
  @@map("botcmd_allowed_channels")
}

model CCPingCommand {
  channel_id String
  created_at DateTime @default(now())
  created_by String
  guild_id   String
  id         String   @id @default(uuid())
  name       String
  role_id    String
  updated_at DateTime @updatedAt

  @@unique([guild_id, name])
  @@index([guild_id])
  @@map("ccping_commands")
}

model CCPingPermit {
  added_by   String
  created_at DateTime @default(now())
  guild_id   String
  id         String   @id @default(uuid())
  is_role    Boolean  @default(false)
  target_id  String

  @@unique([guild_id, target_id])
  @@index([guild_id])
  @@map("ccping_permits")
}

model ChatLog {
  channel_id            String
  channel_name          String?
  content_length        Int?
  created_at            DateTime          @default(now())
  deleted_at            DateTime?
  guild_id              String
  id                    String            @id @default(uuid())
  in_voice_chat         Boolean?          @default(false)
  mentioned_user_ids    String? // JSON array of mentioned user IDs (from @mentions)
  mentioned_user_ids_v2 Json?
  message_id            String
  replied_to_id         String? // Track who they're replying to
  user_cache            DiscordUserCache? @relation(fields: [user_id], references: [user_id], onDelete: NoAction)
  user_id               String

  @@index([created_at])
  @@index([guild_id, channel_id])
  @@index([guild_id, created_at])
  @@index([guild_id, user_id, created_at])
  @@index([guild_id, user_id])
  @@index([user_id, created_at])
  @@map("chat_logs")
}

model CommandHash {
  command_name  String
  hash          String
  id            String   @id @default(uuid())
  last_deployed DateTime @default(now())
  scope_id      String? // null for global, guild_id for guild
  scope_type    String // 'global' | 'guild'

  @@unique([command_name, scope_type, scope_id])
  @@index([scope_type, scope_id])
  @@map("command_hashes")
}

model CustomCommand {
  created_at DateTime @default(now())
  created_by String
  guild_id   String
  id         String   @id @default(uuid())
  name       String
  role_id    String
  updated_at DateTime @updatedAt

  @@unique([guild_id, name])
  @@index([guild_id])
  @@map("custom_commands")
}

model CustomCommandPermittedUser {
  added_by         String
  allowed_role_ids String[] @default([]) // Restrict which CC role(s) this entity can grant
  created_at       DateTime @default(now())
  guild_id         String
  id               String   @id @default(uuid())
  is_role          Boolean  @default(false)
  target_id        String // User or Role ID

  @@unique([guild_id, target_id])
  @@index([guild_id])
  @@map("custom_command_permitted_users")
}

model DiscordChannelCache {
  channel_id  String   @id
  created_at  DateTime @default(now())
  guild_id    String
  is_deleted  Boolean  @default(false)
  name        String
  parent_id   String? // Category channel ID
  parent_name String? // Category channel name
  position    Int      @default(0)
  type        Int      @default(2) // 0=text, 2=voice, 13=stage, etc.
  updated_at  DateTime @updatedAt

  @@index([guild_id])
  @@index([name])
  @@map("discord_channel_cache")
}

model DiscordUserCache {
  avatar_url    String?
  chat_logs     ChatLog[]
  created_at    DateTime  @default(now())
  discriminator String    @default("0")
  display_name  String
  global_name   String?
  in_guild      Boolean   @default(true)
  joined_at     String?
  nickname      String?
  roles         String? // JSON array of role IDs
  tickets       Ticket[]
  updated_at    DateTime  @updatedAt
  user_id       String    @id
  username      String

  @@index([display_name])
  @@index([username])
  @@map("discord_user_cache")
}

model DonatorPlan {
  created_at           DateTime              @default(now())
  created_by           String // Admin user ID
  crypto_enabled       Boolean               @default(true)
  description          String?
  enabled              Boolean               @default(true)
  guild_id             String
  id                   String                @id @default(uuid())
  linked_role_id       String // Role ID to assign when user purchases
  nowpayments_payments NowPaymentsPayment[]
  ozy_enabled          Boolean               @default(false)
  paused               Boolean               @default(false)
  payments             RazorpayPayment[]
  perks                String[] // Array of perks/benefits
  price                Int // Price in USD (will be converted to INR)
  price_crypto         Int? // Optional Crypto price override in USD (will default to price if null)
  price_ozy            Int? // Ozy amount charged for direct balance purchases
  subscriptions        DonatorSubscription[]
  title                String // e.g., "Premium", "Gold", "Platinum"
  updated_at           DateTime              @updatedAt

  @@unique([guild_id, title])
  @@index([guild_id])
  @@index([linked_role_id])
  @@map("donator_plans")
}

model DonatorSubscription {
  cancelled_at DateTime?
  cancelled_by String? // Admin ID if manually cancelled
  created_at   DateTime    @default(now())
  expiry_date  DateTime? // null for lifetime
  guild_id     String
  id           String      @id @default(uuid())
  payment_id   String? // Razorpay payment ID
  plan         DonatorPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  plan_id      String
  start_date   DateTime    @default(now())
  status       String      @default("active") // active, cancelled, expired
  updated_at   DateTime    @updatedAt
  user_id      String

  @@unique([guild_id, user_id, plan_id])
  @@index([created_at])
  @@index([guild_id, user_id])
  @@index([status])
  @@index([user_id])
  @@map("donator_subscriptions")
}

model EconomyAllowedChannel {
  added_by   String
  channel_id String
  created_at DateTime @default(now())
  guild_id   String

  @@id([guild_id, channel_id])
  @@map("economy_allowed_channels")
}

model EconomyBlacklistCategory {
  added_by    String
  category_id String
  created_at  DateTime @default(now())
  guild_id    String

  @@id([guild_id, category_id])
  @@index([guild_id])
  @@map("economy_blacklist_categories")
}

model EconomyBlacklistChannel {
  added_by     String
  channel_id   String
  channel_type String // 'text' or 'voice'
  created_at   DateTime @default(now())
  guild_id     String

  @@id([guild_id, channel_id])
  @@index([guild_id, channel_type])
  @@map("economy_blacklist_channels")
}

model EconomyBlacklistMember {
  added_by   String
  created_at DateTime @default(now())
  guild_id   String
  reason     String?
  user_id    String
  user_name  String?

  @@id([guild_id, user_id])
  @@index([guild_id])
  @@map("economy_blacklist_members")
}

model EconomyBlacklistRole {
  added_by   String
  created_at DateTime @default(now())
  guild_id   String
  role_id    String

  @@id([guild_id, role_id])
  @@index([guild_id])
  @@map("economy_blacklist_roles")
}

model EconomyCategoryReward {
  category_id          String
  category_name        String?
  created_at           DateTime @default(now())
  guild_id             String
  id                   String   @id @default(uuid())
  message_enabled      Boolean  @default(true)
  msg_min_length       Int      @default(5) // Min message length
  msg_min_per_minute   Int      @default(3) // Min valid messages in a minute to earn
  msg_ozy_amount       Int      @default(1) // Coins per cycle
  updated_at           DateTime @updatedAt
  vc_count_bots        Boolean  @default(false) // Include bots in member count
  vc_enabled           Boolean  @default(true)
  vc_ignore_deafened   Boolean  @default(false) // Ignore users who are deafened
  vc_ignore_self_muted Boolean  @default(false) // Ignore users who are self-muted
  vc_min_members       Int      @default(1) // Min members in VC
  vc_minutes_per_point Int      @default(5) // Minutes per cycle
  vc_ozy_amount        Int      @default(1) // Coins per cycle

  @@unique([guild_id, category_id])
  @@index([guild_id])
  @@map("economy_category_rewards")
}

model EconomyClaimLog {
  amount        Int // messages count or minutes
  claim_type    String // 'messages' or 'voice'
  created_at    DateTime @default(now())
  guild_id      String
  id            String   @id @default(uuid())
  points_earned Int
  user_id       String

  @@index([guild_id, created_at])
  @@index([guild_id, user_id])
  @@map("economy_claim_logs")
}

model EconomyConfig {
  advanced_mode             Boolean  @default(false)
  afk_channel_id            String?
  ag_role_id                String?
  casino_logs_channel_id    String?
  cbl_role_id               String?
  coins_per_invite          Int      @default(100) // Coins earned when someone joins via invite
  count_bots                Boolean  @default(false) // Include bots in member count
  created_at                DateTime @default(now())
  currency_emoji            String   @default("🪙")
  currency_name             String   @default("Ozy")
  ozy_inr_rate              Float    @default(18.0)
  economy_channel_id        String?
  enabled                   Boolean  @default(false)
  guild_id                  String   @id
  ignore_afk_channel        Boolean  @default(true)
  ignore_deafened           Boolean  @default(false)
  ignore_self_muted         Boolean  @default(false)
  invites_enabled           Boolean  @default(true)
  leaderboard_sync          Boolean  @default(true)
  logs_channel_id           String?
  min_message_length        Int      @default(5)
  minutes_per_point         Int      @default(5) // Minutes per cycle
  msg_ozy_amount            Int      @default(1) // Coins per cycle
  require_two_members       Int      @default(1) // Min members in VC
  shop_enabled              Boolean  @default(true)
  updated_at                DateTime @updatedAt
  vc_ozy_amount             Int      @default(1) // Coins per cycle
  vc_enabled                Boolean  @default(true)
  message_enabled           Boolean  @default(true)
  afk_verify_enabled        Boolean  @default(false)
  afk_verify_min            Int      @default(80)
  afk_verify_max            Int      @default(90)
  purchase_cooldown_enabled Boolean  @default(false) // Global cooldown between shop purchases
  purchase_cooldown_hours   Int      @default(24) // Cooldown duration in hours
  max_grind_enabled         Boolean  @default(false) // Cap daily earning time
  max_grind_hours           Int      @default(8) // Max earning hours per GMT day
  msg_min_per_minute        Int      @default(3) // Min valid messages in a minute to earn
  msg_count_emojis          Boolean  @default(false) // Count emojis toward message length
  msg_count_stickers        Boolean  @default(false) // Count sticker-only messages as valid

  @@map("economy_config")
}

model EconomyDailyGrind {
  created_at     DateTime @default(now())
  day            String // GMT/UTC calendar day, YYYY-MM-DD
  earned_seconds Int      @default(0) // Earning-eligible VC seconds credited today
  guild_id       String
  updated_at     DateTime @updatedAt
  user_id        String

  @@id([guild_id, user_id, day])
  @@index([guild_id, day])
  @@map("economy_daily_grind")
}

model EconomyIgnoredChannel {
  channel_id String
  guild_id   String

  @@id([guild_id, channel_id])
  @@map("economy_ignored_channels")
}

model EconomyInvite {
  active          Boolean   @default(true) // Whether the invited user is still in the server
  coins_earned    Int       @default(0) // Coins earned from this invite
  created_at      DateTime  @default(now())
  guild_id        String
  id              String    @id @default(cuid())
  invite_code     String // The invite code used
  invited_user_id String // Who was invited
  inviter_id      String // Who created the invite
  joined_at       DateTime  @default(now())
  left_at         DateTime?
  updated_at      DateTime  @updatedAt

  @@unique([guild_id, invited_user_id]) // One invite per user per guild
  @@index([guild_id])
  @@index([invite_code])
  @@index([invited_user_id])
  @@index([inviter_id])
  @@map("economy_invites")
}

model EconomyInviteStats {
  active_invites Int      @default(0) // Number of users still in server
  coins_earned   Int      @default(0) // Total coins from invites
  created_at     DateTime @default(now())
  fake_invites   Int      @default(0) // Number of detected fake invites
  guild_id       String
  id             String   @id @default(cuid())
  total_invites  Int      @default(0)
  updated_at     DateTime @updatedAt
  user_id        String // The inviter

  @@unique([guild_id, user_id])
  @@index([guild_id])
  @@map("economy_invite_stats")
}

model EconomyMessageProgress {
  accumulated_msgs Int      @default(0) // Progress towards next cycle
  category_id      String // Category or "global"
  created_at       DateTime @default(now())
  guild_id         String
  id               String   @id @default(uuid())
  updated_at       DateTime @updatedAt
  user_id          String

  @@unique([guild_id, user_id, category_id])
  @@index([guild_id, user_id])
  @@map("economy_message_progress")
}

model EconomyPointLog {
  admin_id   String? // For manual adjustments
  amount     Int
  created_at DateTime @default(now())
  guild_id   String
  id         String   @id @default(uuid())
  reason     String
  source     String // 'messages', 'voice', 'manual', 'claim'
  user_id    String

  @@index([guild_id, created_at])
  @@index([guild_id, user_id])
  @@map("economy_point_logs")
}

model EconomyUser {
  created_at         DateTime  @default(now())
  deleted_at         DateTime?
  guild_id           String
  id                 String    @id @default(uuid())
  leaderboard_points Int       @default(0)
  month_start        String?
  monthly_points     Int       @default(0)
  total_messages     Int       @default(0)
  total_points       Int       @default(0)
  total_vc_minutes   Int       @default(0)
  updated_at         DateTime  @updatedAt
  user_id            String
  valid_messages     Int       @default(0)
  week_start         String?
  weekly_points      Int       @default(0)
  temp_blocked_until DateTime?
  temp_block_reason  String?

  @@unique([guild_id, user_id])
  @@index([guild_id, created_at])
  @@index([guild_id, leaderboard_points])
  @@index([guild_id, monthly_points])
  @@index([guild_id, total_points])
  @@index([guild_id, weekly_points])
  @@index([user_id, created_at])
  @@map("economy_users")
}

model EconomyVCProgress {
  accumulated_seconds Int      @default(0) // Progress towards next cycle
  category_id         String // Category or "global"
  created_at          DateTime @default(now())
  guild_id            String
  id                  String   @id @default(uuid())
  updated_at          DateTime @updatedAt
  user_id             String

  @@unique([guild_id, user_id, category_id])
  @@index([guild_id, user_id])
  @@map("economy_vc_progress")
}

model EconomyVoiceSession {
  channel_id     String
  guild_id       String
  id             String    @id @default(uuid())
  is_deafened    Boolean   @default(false)
  is_muted       Boolean   @default(false)
  joined_at      DateTime  @default(now())
  left_at        DateTime?
  minutes_earned Int       @default(0)
  user_id        String

  @@index([guild_id, user_id])
  @@map("economy_voice_sessions")
}

model EmergencyMode {
  enabled    Boolean  @default(false)
  enabled_at DateTime @default(now())
  enabled_by String
  guild_id   String   @id
  mode_type  String? // "raid", "scam_attack", "bot_attack"
  reason     String?

  @@map("emergency_modes")
}

model GreetConfig {
  autodelete_time Int      @default(0) // seconds, 0 = disabled
  channel_id      String
  created_at      DateTime @default(now())
  created_by      String
  enabled         Boolean  @default(true)
  greet_name      String
  guild_id        String
  id              String   @id @default(uuid())
  message         String   @db.Text
  updated_at      DateTime @updatedAt

  @@unique([guild_id, greet_name])
  @@index([guild_id])
  @@map("greet_configs")
}

model GuildCaseCounter {
  guild_id         String @id
  last_case_number Int    @default(0)

  @@map("guild_case_counter")
}

model GuildPrefix {
  created_at DateTime @default(now())
  guild_id   String   @id
  prefix     String   @default(".")
  updated_at DateTime @updatedAt

  @@map("guild_prefixes")
}

model GuildSettings {
  created_at    DateTime @default(now())
  guild_id      String   @id
  main_guild_id String? // Reference to main guild for appeal servers
  unban_role_id String? // Role that can unban across servers
  updated_at    DateTime @updatedAt

  @@map("guild_settings")
}

model JailConfig {
  channel_id String
  created_at DateTime @default(now())
  guild_id   String   @id
  role_id    String
  updated_at DateTime @updatedAt

  @@map("jail_configs")
}

model JailedUser {
  created_at DateTime @default(now())
  guild_id   String
  id         String   @id @default(uuid())
  jailed_by  String
  reason     String?
  user_id    String

  @@unique([guild_id, user_id])
  @@map("jailed_users")
}

model JailerPermit {
  added_by   String
  created_at DateTime @default(now())
  guild_id   String
  id         String   @id @default(uuid())
  user_id    String

  @@unique([guild_id, user_id])
  @@map("jailer_permits")
}

model MailCategory {
  auto_close_hours      Int?
  channel_category_id   String
  transcript_channel_id String?
  created_at            DateTime @default(now())
  guild_id              String
  id                    String   @id @default(uuid())
  name                  String
  staff_role_ids        String[]

  @@map("mail_categories")
}

model MailConfig {
  ask_confirmation      Boolean? @default(false)
